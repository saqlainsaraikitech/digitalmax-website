# DigitalMax — serve index.html for clean page URLs (/consultancy, /tools, ...)
# ErrorDocument makes sure missing URLs show our own custom 404 page, never Hostinger's.
ErrorDocument 404 /index.html
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>
